# AnimateMyPicture Environment Variables
# Copy this file to .env and fill in your own values

# ============================================
# GOOGLE CLOUD CONFIGURATION
# ============================================
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Firestore Database (optional, defaults to "(default)")
FIRESTORE_DATABASE=(default)

# ============================================
# REPLICATE AI CONFIGURATION
# ============================================
# Get your API token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ============================================
# STRIPE PAYMENT CONFIGURATION
# ============================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Webhook secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ============================================
# INTERNAL SECURITY
# ============================================
# Generate a secure random key (e.g., openssl rand -hex 32)
INTERNAL_API_KEY=your-secure-internal-api-key-min-32-chars

# ============================================
# CLOUD TASKS CONFIGURATION
# ============================================
USE_CLOUD_TASKS=false  # Set to true in production
TASKS_QUEUE=animatemyphoto-queue
TASKS_LOCATION=us-central1
TASKS_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# ============================================
# EMAIL CONFIGURATION (BREVO)
# ============================================
# Get from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=AnimateMyPicture

# ============================================
# WHATSAPP CONFIGURATION (OPTIONAL)
# ============================================
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_ADMIN_NUMBERS=+33600000000,+33700000000

# ============================================
# GOOGLE GEMINI AI (OPTIONAL)
# ============================================
# For prompt enhancement
GOOGLE_GENAI_API_KEY=your_google_gemini_api_key_here
ENABLE_GEMINI_ENHANCEMENT=false

# ============================================
# ELEVENLABS MUSIC (OPTIONAL)
# ============================================
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ENABLE_AI_MUSIC=false

# ============================================
# FREESOUND API (OPTIONAL)
# ============================================
# For royalty-free music - Get from https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=your-freesound-api-key

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment: development or production
IS_PRODUCTION=false
ENVIRONMENT=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5177,http://localhost:3000

# Backend URL (for internal use)
BACKEND_URL=http://localhost:8093
PUBLIC_API_URL=http://localhost:8093

# Frontend URL (for emails and redirects)
FRONTEND_URL=http://localhost:5177

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Debug mode
DEBUG=true

# Test promo code (optional)
TEST_PROMO_CODE=TESTCODE2024

# Force direct upload in dev (bypass signed URLs)
FORCE_DIRECT_UPLOAD=false

# ============================================
# PERFORMANCE TUNING
# ============================================
# Max workers for parallel processing
MAX_WORKERS=3

# Video generation timeout (seconds)
GENERATION_TIMEOUT=720

# FFmpeg settings
FFMPEG_PRESET=medium
FFMPEG_CRF=18

# ============================================
# MONITORING (OPTIONAL)
# ============================================
# Sentry error tracking
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Google Cloud Monitoring
ENABLE_CLOUD_MONITORING=false

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_WATERMARK=false
ENABLE_ANALYTICS=false
ENABLE_RATE_LIMITING=true
ENABLE_WEBHOOK_VALIDATION=true

# ============================================
# REDIS CACHE (OPTIONAL)
# ============================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=900  # 15 minutes

# ============================================
# DATABASE URLs (OPTIONAL)
# ============================================
# If using PostgreSQL instead of Firestore
DATABASE_URL=postgresql://user:password@localhost/animatemypicture

# ============================================
# DOCKER CONFIGURATION
# ============================================
# Ports for local development
BACKEND_PORT=8093
FRONTEND_PORT=5177

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# SECURITY HEADERS
# ============================================
ENABLE_SECURITY_HEADERS=true
CSP_POLICY=default-src 'self'